# URL interna del backend Nest.js (server-to-server, nunca llega al navegador).
# El proxy en src/app/api/[...path]/route.ts la usa para reenviar todo lo que
# el navegador pide a /api/*. En local, con el backend corriendo en la misma
# máquina, el default alcanza aunque el frontend esté expuesto por un túnel.
BACKEND_INTERNAL_URL=http://localhost:3002

# Mismo valor que PROXY_SHARED_SECRET en backend/.env.example. El proxy
# (src/app/api/[...path]/route.ts) lo manda como header x-proxy-secret junto
# con x-client-ip, para que el backend pueda confiar en esa IP.
PROXY_SHARED_SECRET=cambiar-por-secreto-largo-y-aleatorio

# Cloudflare Turnstile: site key pública (va en el HTML, no es secreta).
# Mismo par que TURNSTILE_SECRET_KEY en backend/.env.example.
# Clave de prueba oficial de Cloudflare (siempre pasa): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=cambiar-por-site-key-de-turnstile
