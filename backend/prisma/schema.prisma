generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoSilla {
  LIBRE
  PAGO_PENDIENTE // pago directo a esta silla puntual, esperando confirmación de MP
  RESERVADA // asignada a un Turno de la cola, esperando que el cliente confirme presencia
  EN_USO
  FUERA_DE_SERVICIO
}

enum EstadoSesion {
  PENDIENTE // preferencia creada, esperando pago (timeout 3 min)
  ESPERANDO_CONFIRMACION // pago aprobado, silla reservada: el cliente tiene unos minutos para sentarse y confirmar
  ESPERANDO_ENERGIA // pago aprobado pero el Shelly estaba offline: no se pudo encender todavía
  ACTIVA // pagada o activada manualmente, silla encendida
  SALIDA // tiempo cumplido: pausa + pulso de retorno para que la silla se levante y el cliente pueda salir
  COMPLETADA // terminó su tiempo normalmente
  CANCELADA // pago no llegó, parada de emergencia, corte de energía largo, etc.
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  // Estaba APROBADO y Mercado Pago después lo reportó refunded/charged_back/
  // cancelled (Bloque B). No se corta la corriente automáticamente: queda
  // para que el dueño lo resuelva desde el panel (ver requiereRevision).
  REEMBOLSADO
}

enum EstadoTurno {
  ESPERANDO_PAGO // preferencia creada, esperando pago (timeout 3 min)
  EN_COLA // pago aprobado, esperando que se libere una silla
  ASIGNADO // se le asignó una silla libre, esperando confirmación (timeout 2 min)
  EN_USO // confirmó y la silla está encendida (ver Sesion enlazada)
  COMPLETADA // terminó su tiempo normalmente
  CANCELADA // no pagó a tiempo, no confirmó a tiempo, etc.
}

enum EstadoCredito {
  DISPONIBLE
  CANJEADO
  VENCIDO
}

model Silla {
  id              String      @id @default(uuid())
  nombre          String
  estado          EstadoSilla @default(LIBRE)
  // Dos opciones de masaje que el cliente elige antes de pagar; la landing
  // trae la opción 2 seleccionada. Se copian a la Sesion/Turno al crearlos,
  // así que editarlas no afecta lo que ya está pago.
  opcion1DuracionMin Int     @default(5) @map("opcion1_duracion_min")
  opcion1Precio      Decimal @db.Decimal(10, 2) @map("opcion1_precio")
  opcion2DuracionMin Int     @default(10) @map("opcion2_duracion_min")
  opcion2Precio      Decimal @db.Decimal(10, 2) @map("opcion2_precio")
  // Tiempos propios de la masajeadora (ver SesionesService): gracia para que
  // el cliente se siente y presione START, pausa con la silla apagada al
  // terminar, y pulso de energía para que vuelva a la posición vertical.
  graciaInicioSeg Int         @default(30) @map("gracia_inicio_seg")
  pausaRetornoSeg Int         @default(10) @map("pausa_retorno_seg")
  retornoSeg      Int         @default(40) @map("retorno_seg")
  deviceIdShelly  String      @map("device_id_shelly")
  // Modelo/generación detectados al vincular (ej: "S3SW-001X16EU / G3")
  modeloShelly    String?     @map("modelo_shelly")
  finSesionActual DateTime?   @map("fin_sesion_actual")
  creadaEn        DateTime    @default(now()) @map("creada_en")
  sesiones        Sesion[]
  turnos          Turno[]

  @@map("sillas")
}

model Sesion {
  id                String       @id @default(uuid())
  sillaId           String       @map("silla_id")
  silla             Silla        @relation(fields: [sillaId], references: [id])
  estado            EstadoSesion @default(PENDIENTE)
  externalReference String       @unique @map("external_reference")
  monto             Decimal      @db.Decimal(10, 2)
  duracionMin       Int          @map("duracion_min")
  // Opción de masaje que eligió el cliente (1 o 2). Null en activaciones
  // manuales y en sesiones anteriores a que existieran las opciones.
  opcion            Int?
  // Copia de los tiempos de la silla al crear la sesión (igual que
  // duracionMin): cambiarlos en el panel no afecta una sesión en curso.
  graciaInicioSeg   Int          @default(30) @map("gracia_inicio_seg")
  pausaRetornoSeg   Int          @default(10) @map("pausa_retorno_seg")
  retornoSeg        Int          @default(40) @map("retorno_seg")
  // Fin de la fase SALIDA (pausa + retorno). Null fuera de esa fase.
  salidaHasta       DateTime?    @map("salida_hasta")
  esManual          Boolean      @default(false) @map("es_manual")
  creadaEn          DateTime     @default(now()) @map("creada_en")
  // Momento en que el pago quedó aprobado. Puede ser anterior a `inicio` si
  // la silla estaba sin energía cuando llegó el pago (ver ESPERANDO_ENERGIA).
  pagadaEn          DateTime?    @map("pagada_en")
  inicio            DateTime?
  finProgramado     DateTime?    @map("fin_programado")
  finReal           DateTime?    @map("fin_real")
  motivoCierre      String?      @map("motivo_cierre")
  // Corte de energía en curso: cuándo se detectó que el Shelly quedó offline.
  // Null mientras la sesión corre normal. Ver EnergiaService.
  interrumpidaEn      DateTime?  @map("interrumpida_en")
  // Segundos ya devueltos al cliente por cortes de esta sesión, y cuántos
  // cortes tuvo. Se muestran en el panel y en la pantalla del cliente.
  segundosCompensados Int        @default(0) @map("segundos_compensados")
  cortes              Int        @default(0)
  // Hash HMAC-SHA256 de la IP real que creó la reserva (Hallazgo ALTO 2):
  // nunca se guarda la IP en claro. Sirve para limitar cuántas reservas
  // pendientes puede tener una misma IP a la vez.
  ipHash              String?    @map("ip_hash")
  pagos             Pago[]
  turno             Turno?
  creditos          Credito[]    @relation("CreditosDeSesion")

  @@index([sillaId, estado])
  @@index([ipHash, estado])
  @@map("sesiones")
}

model Pago {
  id          String     @id @default(uuid())
  // Una de las dos siempre está seteada: pago directo a una silla (sesionId)
  // o pago para entrar a la cola compartida (turnoId). Se registra siempre,
  // aprobado o no, para auditoría — incluso si después no llega a activar
  // ninguna silla (ver PagosService.procesarNotificacionPago). Ninguna de
  // las dos: external_reference desconocido (Bloque B).
  sesionId    String?    @map("sesion_id")
  sesion      Sesion?    @relation(fields: [sesionId], references: [id])
  turnoId     String?    @map("turno_id")
  turno       Turno?     @relation(fields: [turnoId], references: [id])
  paymentIdMp String     @unique @map("payment_id_mp")
  monto       Decimal    @db.Decimal(10, 2)
  estado      EstadoPago
  rawWebhook  Json?      @map("raw_webhook")
  recibidoEn  DateTime   @default(now()) @map("recibido_en")
  // Bloque B (hallazgo MEDIO): pago aprobado que no llegó a activar ningún
  // servicio (sesión/turno ya no pendiente, monto insuficiente, moneda
  // distinta de ARS, external_reference desconocido) o que MP marcó
  // refunded/charged_back/cancelled después de haber sido APROBADO. El dueño
  // lo resuelve desde /admin/pagos/revision.
  requiereRevision Boolean   @default(false) @map("requiere_revision")
  motivoRevision   String?   @map("motivo_revision")
  resolucion       String?   // VALE_EMITIDO | REEMBOLSADO_MANUAL | IGNORADO
  resueltoEn       DateTime? @map("resuelto_en")

  @@index([requiereRevision, resueltoEn])
  @@map("pagos")
}

// Turno en la cola compartida entre todas las sillas del local. Se paga al
// anotarse (no al confirmar), y cuando se libera una silla se le asigna al
// turno más antiguo en EN_COLA — con una ventana de 2 min para confirmar
// presencia antes de pasar al siguiente.
model Turno {
  id                String      @id @default(uuid())
  codigo            String?     @unique // "ABC-1234", asignado al aprobarse el pago
  estado            EstadoTurno @default(ESPERANDO_PAGO)
  externalReference String      @unique @map("external_reference")
  monto             Decimal     @db.Decimal(10, 2)
  duracionMin       Int         @map("duracion_min")
  // Opción elegida al anotarse (1 o 2). Null en turnos de canje de vale.
  opcion            Int?
  // Mismo hash que Sesion.ipHash, mismo motivo (Hallazgo ALTO 2).
  ipHash            String?     @map("ip_hash")
  sillaId           String?     @map("silla_id")
  silla             Silla?      @relation(fields: [sillaId], references: [id])
  sesionId          String?     @unique @map("sesion_id")
  sesion            Sesion?     @relation(fields: [sesionId], references: [id])
  pagos             Pago[]
  // Seteado cuando el turno nace del canje de un crédito en vez de un pago.
  creditoOrigen     Credito?
  creadoEn          DateTime    @default(now()) @map("creado_en")
  pagadoEn          DateTime?   @map("pagado_en")
  asignadoEn        DateTime?   @map("asignado_en")
  finReal           DateTime?   @map("fin_real")
  motivoCierre      String?     @map("motivo_cierre")

  @@index([estado, pagadoEn])
  @@index([ipHash, estado])
  @@map("turnos")
}

// Vale por un turno ya pagado que no se pudo prestar (corte de energía largo,
// silla sin luz cuando llegó el pago). El cliente lo canjea escaneando
// cualquier QR e ingresando el código: se convierte en un Turno de la cola
// con monto 0, sin volver a pagar.
model Credito {
  id     String        @id @default(uuid())
  codigo String        @unique // "LUZ-4821"
  estado EstadoCredito @default(DISPONIBLE)

  duracionMin Int    @map("duracion_min")
  motivo      String // corte_de_energia | sin_energia_al_pagar

  // Se usa como `pagadoEn` del turno que genera el canje: el cliente vuelve
  // a la cola con la antigüedad que ya tenía, no al final de la fila por un
  // corte que no provocó.
  prioridadDesde DateTime @map("prioridad_desde")

  sesionOrigenId String? @map("sesion_origen_id")
  sesionOrigen   Sesion? @relation("CreditosDeSesion", fields: [sesionOrigenId], references: [id])

  turnoGeneradoId String? @unique @map("turno_generado_id")
  turnoGenerado   Turno?  @relation(fields: [turnoGeneradoId], references: [id])

  creadoEn   DateTime  @default(now()) @map("creado_en")
  venceEn    DateTime  @map("vence_en")
  canjeadoEn DateTime? @map("canjeado_en")

  @@index([estado, venceEn])
  @@map("creditos")
}

model UsuarioAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  // Se incrementa en cada logout (Hallazgo MEDIO: revocación). JwtAuthGuard
  // compara este valor contra el del token en cada request; si no coinciden,
  // el token quedó revocado aunque no haya expirado todavía.
  tokenVersion Int       @default(0) @map("token_version")
  ultimoLogin  DateTime? @map("ultimo_login")
  creadoEn     DateTime  @default(now()) @map("creado_en")

  @@map("usuarios_admin")
}
