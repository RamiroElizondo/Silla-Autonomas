# Base de datos
DATABASE_URL=postgresql://sillas:password@localhost:5432/sillas

# Servidor
PORT=3002
# Secreto compartido con el proxy del frontend (frontend/.env.local.example)
# para poder confiar en el header x-client-ip: sin esto, el rate limit por
# IP no distingue clientes (ver backend/src/common/client-ip.util.ts).
# Generar con: openssl rand -hex 32
# Obligatorio si NODE_ENV=production (el backend no arranca sin esto).
PROXY_SHARED_SECRET=cambiar-por-secreto-largo-y-aleatorio

# Fallback para los back_urls si el checkout llega sin `origin` (curl/Postman).
# La URL del Webhook se configura en Tus integraciones de Mercado Pago.
FRONTEND_URL=http://localhost:3003

# Admin (JWT)
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Seed del usuario admin (npm run seed)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-password

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxx
# Hallazgo ALTO 4: sin MP_WEBHOOK_SECRET el webhook rechaza TODO (falla
# cerrado) — obligatorio en producción, el arranque aborta si falta.
# MP_WEBHOOK_ALLOW_UNSIGNED=true es la ÚNICA excepción, y SOLO fuera de
# producción: permite probar el flujo de pago en desarrollo local sin
# configurar el secreto real de Mercado Pago. Nunca ponerla en producción.
# MP_WEBHOOK_ALLOW_UNSIGNED=true

# Shelly Cloud Control API v2
# https://shelly-api-docs.shelly.cloud/cloud-control-api/communication-v2
# SHELLY_SERVER: el server de la cuenta, sin barra final. Figura junto a la auth
#   key en https://control.shelly.cloud > Settings > Authorization cloud key.
# SHELLY_AUTH_KEY: la misma "Authorization cloud key". OJO: se invalida si se
#   cambia la contraseña de la cuenta Shelly (hay que regenerarla y actualizar acá).
# La cuenta Shelly debe ser la del dueño del local (un device pertenece a una
# sola cuenta), no una cuenta de desarrollo.
SHELLY_SERVER=https://shelly-XX-eu.shelly.cloud
SHELLY_AUTH_KEY=xxxxxxxx

# Cloudflare Turnstile (Hallazgo ALTO 2): evita que un script repita el
# checkout y deje sillas bloqueadas sin pagar. Site key va en
# frontend/.env.local.example (NEXT_PUBLIC_TURNSTILE_SITE_KEY).
# Conseguir ambas en https://dash.cloudflare.com/ > Turnstile.
# Para pruebas manuales, Cloudflare tiene claves de prueba oficiales:
#   site key  1x00000000000000000000AA  (siempre pasa)
#   site key  2x00000000000000000000AB  (siempre falla)
#   secret key 1x0000000000000000000000000000000AA (siempre pasa)
#   secret key 2x0000000000000000000000000000000AA (siempre falla)
# Obligatoria si NODE_ENV=production (el backend no arranca sin esto).
TURNSTILE_SECRET_KEY=cambiar-por-secret-key-de-turnstile

# Secreto para hashear la IP real antes de guardarla en Sesion/Turno
# (nunca se guarda la IP en claro). Generar con: openssl rand -hex 32
# Obligatorio si NODE_ENV=production.
IP_HASH_SECRET=cambiar-por-secreto-largo-y-aleatorio

# Tope de reservas pendientes (PENDIENTE/ESPERANDO_PAGO) por IP antes de
# responder 429. Default 3 porque el WiFi del local es compartido por varias
# sillas y varios clientes a la vez.
MAX_PENDIENTES_POR_IP=3

# CORS (Bloque D, hallazgo BAJO): lista de orígenes permitidos para
# app.enableCors(), separados por coma. El navegador normal no le pega
# directo al backend (todo pasa por el proxy same-origin del frontend), así
# que esto es sobre todo defensa en profundidad / un consumidor directo
# futuro. Sin configurar: en desarrollo se refleja cualquier origen (como
# antes de que existiera esta variable); en producción se falla CERRADO
# (ningún origen cross-origin permitido) — ver
# `src/common/verificar-entorno.ts` → `resolverCorsOrigins`.
# CORS_ORIGINS=https://midominio.com,https://www.midominio.com

# Bloque de loadtest (backend/loadtest/): con "true", MercadoPagoService
# (crearPreferencia/obtenerPago) y ShellyService.setRele quedan MOCKEADOS —
# nunca llaman a la API real de Mercado Pago ni a la Shelly Cloud API.
# Necesario para poder correr pruebas de carga con autocannon sin aprobar
# pagos de sandbox miles de veces ni reventar el límite de ~1 req/seg de
# Shelly Cloud. Ver backend/loadtest/README.md para el procedimiento
# completo.
# NUNCA debe estar en "true" en producción ni contra una base de datos real:
# el arranque aborta si NODE_ENV=production y LOADTEST=true (ver
# src/common/verificar-entorno.ts) — no hay bandera de escape para esa
# combinación.
# LOADTEST=true

# Apagar relés encendidos sin sesión (red de seguridad de EnergiaService).
# Ponelo en "false" en todo backend que NO sea el dueño de los equipos (beta,
# desarrollo local) si comparte SHELLY_AUTH_KEY y deviceIdShelly con
# producción: si no, apaga las sesiones de producción al minuto.
# APAGAR_RELES_HUERFANOS=false
