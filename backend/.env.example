# Base de datos
DATABASE_URL=postgresql://sillas:password@localhost:5432/sillas

# Servidor
PORT=3001
# Fallback: se usan solo si el checkout llega sin `origin` (curl/Postman).
# En uso normal, el frontend manda su propio origin (window.location.origin,
# típicamente el túnel de cloudflared) y estos dos no hacen falta — un solo
# túnel, el del frontend, alcanza para probar el flujo completo (ver el
# proxy en frontend/src/app/api/[...path]/route.ts).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=https://api.tudominio.com

# Admin (JWT)
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Seed del usuario admin (npm run seed)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-password

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxx

# Shelly Cloud (ver "Authorization cloud key" en https://control.shelly.cloud > Settings)
SHELLY_SERVER=https://shelly-XX-eu.shelly.cloud
SHELLY_AUTH_KEY=xxxxxxxx
