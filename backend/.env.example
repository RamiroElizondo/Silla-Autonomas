# Base de datos
DATABASE_URL=postgresql://sillas:password@localhost:5432/sillas

# Servidor
PORT=3002
# Fallback para los back_urls si el checkout llega sin `origin` (curl/Postman).
# La URL del Webhook se configura en Tus integraciones de Mercado Pago.
FRONTEND_URL=http://localhost:3003

# Admin (JWT)
JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Seed del usuario admin (npm run seed)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-password

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxx

# Shelly Cloud Control API v2
# https://shelly-api-docs.shelly.cloud/cloud-control-api/communication-v2
# SHELLY_SERVER: el server de la cuenta, sin barra final. Figura junto a la auth
#   key en https://control.shelly.cloud > Settings > Authorization cloud key.
# SHELLY_AUTH_KEY: la misma "Authorization cloud key". OJO: se invalida si se
#   cambia la contraseña de la cuenta Shelly (hay que regenerarla y actualizar acá).
# La cuenta Shelly debe ser la del dueño del local (un device pertenece a una
# sola cuenta), no una cuenta de desarrollo.
SHELLY_SERVER=https://shelly-XX-eu.shelly.cloud
SHELLY_AUTH_KEY=xxxxxxxx
